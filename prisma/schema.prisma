// Esquema de datos de la aplicacion de finanzas del hogar.
// Todo dato financiero cuelga de un Household; nunca se consulta sin filtrar por el.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión agrupada (PgBouncer). Es la que usa la app en Vercel: en serverless
  // cada invocación abriría una conexión nueva y Postgres se quedaría sin cupo.
  url       = env("DATABASE_URL")
  // Conexión directa, solo para migraciones: PgBouncer en modo transacción no
  // soporta las sentencias DDL que Prisma necesita.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MIEMBRO
}

enum MovementType {
  INGRESO
  EGRESO
}

enum Frequency {
  SEMANAL
  QUINCENAL
  MENSUAL
  ANUAL
}

enum LoanKind {
  CREDITO
  TARJETA
  HIPOTECA
  VEHICULO
  OTRO
}

enum LoanStatus {
  ACTIVO
  PAGADO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        HouseholdMember[]
  // Movimientos que esta persona registró en la app...
  movimientos        Transaction[]     @relation("MovimientosCreados")
  // ...y aquellos cuyo dinero puso o recibió, que no siempre son los mismos.
  movimientosPagados Transaction[]     @relation("MovimientosPagados")
  reglasPagadas      RecurringRule[]   @relation("ReglasPagadas")
  creditosPagados    Loan[]            @relation("CreditosPagados")
}

model Household {
  id        String   @id @default(cuid())
  nombre    String
  currency  String   @default("COP")
  locale    String   @default("es-CO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miembros     HouseholdMember[]
  invitaciones Invitation[]
  categorias   Category[]
  movimientos  Transaction[]
  presupuestos Budget[]
  recurrentes  RecurringRule[]
  creditos     Loan[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  role        Role     @default(MIEMBRO)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

model Invitation {
  id          String    @id @default(cuid())
  householdId String
  email       String
  role        Role      @default(MIEMBRO)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Category {
  id          String       @id @default(cuid())
  householdId String
  nombre      String
  type        MovementType
  icon        String       @default("Tag")
  color       String       @default("#64748b")
  isSystem    Boolean      @default(false)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  movimientos  Transaction[]
  presupuestos Budget[]
  recurrentes  RecurringRule[]
  creditos     Loan[]

  @@unique([householdId, nombre, type])
  @@index([householdId, type])
}

model Transaction {
  id              String       @id @default(cuid())
  householdId     String
  categoryId      String
  // Quién lo registró en la app.
  createdByUserId String
  // Quién puso la plata (en un egreso) o la recibió (en un ingreso). Es lo que
  // define la cuenta individual, y no tiene por qué ser quien lo registró.
  paidByUserId    String
  type            MovementType
  amount          Decimal      @db.Decimal(14, 2)
  date            DateTime     @db.Date
  descripcion     String
  notas           String?
  // Un movimiento personal es del miembro, no de la casa: suma en su cuenta
  // individual pero queda fuera de los totales del hogar, de los presupuestos
  // y de la comparativa de reportes. Sigue siendo visible para todos.
  esPersonal      Boolean      @default(false)
  loanId          String?
  recurringRuleId String?
  // Identifica el periodo generado por una regla recurrente (ej. "2026-09").
  // Junto con recurringRuleId impide que el cron duplique un movimiento.
  periodKey       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoria   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  autor       User           @relation("MovimientosCreados", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responsable User           @relation("MovimientosPagados", fields: [paidByUserId], references: [id], onDelete: Restrict)
  credito     Loan?          @relation(fields: [loanId], references: [id], onDelete: SetNull)
  regla       RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, periodKey])
  @@index([householdId, date])
  @@index([householdId, categoryId])
  @@index([householdId, paidByUserId, date])
  @@index([householdId, esPersonal, date])
  @@index([loanId])
}

model Budget {
  id          String   @id @default(cuid())
  householdId String
  categoryId  String
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoria Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, year, month])
  @@index([householdId, year, month])
}

model RecurringRule {
  id           String       @id @default(cuid())
  householdId  String
  categoryId   String
  // A quién se le atribuye el movimiento que genera el cron, donde no hay
  // ninguna persona al teclado para elegirlo.
  paidByUserId String
  type         MovementType
  amount       Decimal      @db.Decimal(14, 2)
  descripcion  String
  frequency    Frequency    @default(MENSUAL)
  dayOfMonth   Int          @default(1)
  startDate    DateTime     @db.Date
  endDate      DateTime?    @db.Date
  nextRunDate  DateTime     @db.Date
  autoPost     Boolean      @default(true)
  // Una regla personal genera movimientos personales: cuentan en la cuenta de
  // su responsable, no en la del hogar.
  esPersonal   Boolean      @default(false)
  activa       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoria   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  responsable User          @relation("ReglasPagadas", fields: [paidByUserId], references: [id], onDelete: Restrict)
  movimientos Transaction[]

  @@index([householdId, activa])
  @@index([nextRunDate, activa])
}

model Loan {
  id                String     @id @default(cuid())
  householdId       String
  categoryId        String
  // Quién responde por el crédito. Cada cuota se atribuye a esta persona por
  // defecto: en la práctica siempre la paga la misma.
  paidByUserId      String
  nombre            String
  kind              LoanKind   @default(CREDITO)
  principal         Decimal    @db.Decimal(14, 2)
  interestRate      Decimal    @default(0) @db.Decimal(6, 3)
  totalInstallments Int
  installmentAmount Decimal    @db.Decimal(14, 2)
  startDate         DateTime   @db.Date
  status            LoanStatus @default(ACTIVO)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categoria   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  responsable User          @relation("CreditosPagados", fields: [paidByUserId], references: [id], onDelete: Restrict)
  pagos       Transaction[]

  @@index([householdId, status])
  @@index([householdId, paidByUserId])
}
