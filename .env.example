# PostgreSQL. En local (docker compose up -d) usa la cadena de abajo.
# En produccion, pega aqui la cadena de conexion de Neon (con ?sslmode=require).
DATABASE_URL="postgresql://finanzas:finanzas@localhost:5432/finanzas?schema=public"

# Secreto de sesion. Genera uno con: npx auth secret
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL publica de la app (necesaria en produccion)
AUTH_URL="http://localhost:3000"

# Protege /api/cron/recurrentes. Vercel Cron lo envia como Bearer token.
CRON_SECRET="cambia-esto-tambien"
